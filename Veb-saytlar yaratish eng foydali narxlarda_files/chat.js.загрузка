document.addEventListener("DOMContentLoaded", function () {
    const chatButton = document.querySelector(".js-onicon-button");
    const chatPopup = document.getElementById("chatPopup");
    const closeButton = document.querySelector(".onicon-chat__control--close");
    const messageInput = document.querySelector(".onicon-js-chat-input");
    const sendButton = document.querySelector(".onicon-textarea__send");
    const chatContainer = document.querySelector("#onicon-chat-popup__online");
    const scrollContainer = document.querySelector(
        ".onicon-chat-popup__scroll-hidden"
    );
    const messengerButton = document.querySelector(
        ".mg-global-messengers__button"
    );

    let isFirstMessage = true; // Birinchi xabar uchun flag
    let hasUserInfo = false; // Foydalanuvchi ma'lumotlari kiritilganligini tekshirish

    function closeChat() {
        if (chatPopup) {
            chatPopup.style.visibility = "hidden";
            chatPopup.style.display = "none";
        }
    }
    if (messengerButton) {
        messengerButton.addEventListener("click", closeChat);
    }

    // Chat oynasidan tashqariga bosilganda yopish
    document.addEventListener("click", function (event) {
        if (chatPopup && chatPopup.style.visibility === "visible") {
            if (
                !chatPopup.contains(event.target) &&
                !event.target.closest(".js-onicon-button")
            ) {
                closeChat();
            }
        }
    });
    function toggleChat() {
        if (
            chatPopup.style.visibility === "hidden" ||
            chatPopup.style.display === "none" ||
            chatPopup.style.visibility === ""
        ) {
            chatPopup.style.visibility = "visible";
            chatPopup.style.width = "380px";
            chatPopup.style.height = "450px";
            chatPopup.style.inset = "auto 90px 90px auto";
            chatPopup.style.display = "block";
        } else {
            chatPopup.style.visibility = "hidden";
            chatPopup.style.display = "none";
        }
    }

    function extractUserInfo(message) {
        // Telefon raqam formati tekshiruvi
        const phoneRegex = /\+998[0-9]{9}|[0-9]{9}/;
        const hasPhoneNumber = phoneRegex.test(message);

        // Ism tekshiruvi (kamida 2 ta so'z)
        const words = message.split(/\s+/).filter((word) => word.length > 1);
        const hasName = words.length >= 2;

        return hasPhoneNumber && hasName;
    }

    async function sendMessage() {
        const message = messageInput?.value.trim();

        if (!message) {
            alert("Xabar bo'sh bo'lishi mumkin emas!");
            return;
        }

        try {
            const now = new Date();
            const time = `${String(now.getHours()).padStart(2, "0")}:${String(
                now.getMinutes()
            ).padStart(2, "0")}`;

            // Foydalanuvchi xabarini ko'rsatish
            appendMessage(message, time, "client");

            if (isFirstMessage) {
                // Birinchi xabardan keyin bot javobi
                setTimeout(() => {
                    const botMessage =
                        "Assalom alaykum! IT Progress chat botiga murojaat qildingiz. Iltimos, siz bilan bog'lanish uchun telefon raqamingizni va ismingizni yozib qoldiring:";
                    appendMessage(botMessage, time, "bot");
                }, 1000);
                isFirstMessage = false;
            } else if (!hasUserInfo) {
                // Foydalanuvchi ma'lumotlarini tekshirish
                if (extractUserInfo(message)) {
                    hasUserInfo = true;
                    setTimeout(() => {
                        const botMessage =
                            "Sizning murojaatingiz qabul qilindi. Tez orada siz bilan bog'lanamiz. Rahmat!";
                        appendMessage(botMessage, time, "bot");
                    }, 1000);
                }
            }

            // Xabarni serverga yuborish
            await sendMessageToServer(message, time);

            // Input maydonini tozalash va UI yangilash
            messageInput.value = "";
            updateSendButton();
            scrollToBottom();
        } catch (error) {
            console.error("Xatolik:", error);
            alert("Xabar yuborishda xatolik yuz berdi: " + error.message);
        }
    }

    async function sendMessageToServer(message, time) {
        const token = document.querySelector('meta[name="csrf-token"]');
        if (!token) {
            throw new Error("CSRF token topilmadi");
        }

        const response = await fetch("/send-message", {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                "X-CSRF-TOKEN": token.getAttribute("content"),
                Accept: "application/json",
            },
            body: JSON.stringify({ message, time }),
        });

        return await response.json();
    }

    function appendMessage(message, time, type = "client") {
        const messageClass =
            type === "bot"
                ? "onicon-message--consultant"
                : "onicon-message--client";
        const messageHTML = `
            <div class="onicon-chat-popup__row">
                <div class="onicon-message ${messageClass}">
                    <div class="onicon-message__inner">
                        <p class="onicon-message__text">${message}</p>
                        <time class="onicon-message__time">${time}</time>
                    </div>
                </div>
            </div>
        `;

        if (chatContainer) {
            chatContainer.style.display = "block";
            chatContainer.insertAdjacentHTML("beforeend", messageHTML);
            scrollToBottom();
        }
    }

    function scrollToBottom() {
        if (scrollContainer && chatContainer) {
            scrollContainer.scrollTo({
                top: chatContainer.scrollHeight,
                behavior: "smooth",
            });
        }
    }

    function updateSendButton() {
        if (sendButton) {
            sendButton.classList.add("onicon-textarea__send--active");
            const circle = sendButton.querySelector(
                ".onicon-textarea__svg-circle"
            );
            if (circle) {
                const originalColor = circle.getAttribute("fill");
                circle.setAttribute("fill", "#00FF00");
                setTimeout(() => {
                    circle.setAttribute("fill", originalColor);
                }, 300);
            }
        }
    }

    // Event Listeners
    if (chatButton) chatButton.addEventListener("click", toggleChat);
    if (closeButton) closeButton.addEventListener("click", toggleChat);
    if (messageInput) {
        messageInput.addEventListener("keydown", function (event) {
            if (event.key === "Enter" && !event.shiftKey) {
                event.preventDefault();
                sendMessage();
            }
        });
    }
    if (sendButton) {
        sendButton.addEventListener("click", sendMessage);
        sendButton.addEventListener("mouseover", function () {
            const circle = this.querySelector(".onicon-textarea__svg-circle");
            if (circle) circle.setAttribute("fill", "#009960");
        });
        sendButton.addEventListener("mouseout", function () {
            const circle = this.querySelector(".onicon-textarea__svg-circle");
            if (circle) circle.setAttribute("fill", "#00B172");
        });
    }

    // Pusher Integration
    try {
        const pusher = new Pusher("55f16c29049f79fe665f", {
            cluster: "ap2",
            forceTLS: true,
        });
        const channel = pusher.subscribe("chat");

        channel.bind("message-sent", function (data) {
            // console.log("Yangi xabar keldi:", data);
            appendMessage(
                data.message,
                data.time,
                data.user === "Chat Bot" ? "bot" : "client"
            );
        });

        channel.bind("pusher:subscription_succeeded", () => {
            // console.log("Pusher kanaliga ulandi");
        });

        channel.bind("pusher:subscription_error", (error) => {
            // console.error("Pusher ulanish xatosi:", error);
        });
    } catch (error) {
        // console.error("Pusher xatosi:", error);
    }
});
